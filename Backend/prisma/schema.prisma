// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id         String      @id @default(uuid())
  username   String?
  email      String      @unique
  password   String
  role       UserRole    @default(USER)
  createdAt  DateTime    @default(now())
  updatedAt     DateTime      @updatedAt
  likedSongs    LikedSong[]
  playHistories PlayHistory[]
}

model Song {
  id        String      @id @default(uuid())
  title     String
  audioUrl  String
  imageUrl  String
  duration  Int
  albumID   String?
  category  String?
  isDeleted Boolean @default(false)
  releasedDate DateTime @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  album     Album?      @relation(fields: [albumID], references: [id])
  playlists Playlist[]  @relation("PlaylistSongs")
  likedBy       LikedSong[]
  artists       Artist[]      @relation("ArtistSongs")
  playHistories PlayHistory[]
}

model Album {
  id          String @id @default(uuid())
  imageUrl    String
  title       String
  releaseYear Int?
  songs       Song[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artists   Artist[] @relation("ArtistAlbums")
}

model Playlist {
  id          String   @id @default(uuid())
  name        String
  description String
  isPublic    Boolean  @default(false)
  imageUrl    String
  userId      String
  songs       Song[]   @relation("PlaylistSongs")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LikedSong {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
}

model Artist {
  id        String    @id @default(uuid())
  name      String    @unique
  imageUrl  String
  bio       String?
  // Relations
  songs     Song[]    @relation("ArtistSongs")
  albums    Album[]   @relation("ArtistAlbums")
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PlayHistory {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  playedAt  DateTime @default(now()) @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
}
